# LiteLLM Configuration for Self-Consistency Agent
# Copy this file to .env and configure your settings

# LLM Model Configuration
# The model identifier to use with your LLM provider
# For token confidence features, use models that support structured outputs + logprobs:
# - openrouter/gpt-4o-mini (recommended, best performance/cost)
# - openrouter/gpt-4o (higher quality, more expensive)
# - gpt-4o-mini (direct OpenAI)
# - gpt-4o (direct OpenAI)
# Other examples: claude-3-haiku, mistral-7b, gemma, phi4, qwen2-math-7b, deepseek-math-7b
LLM_MODEL=openrouter/gpt-4o-mini

# LLM Temperature (0.0 - 2.0)
# Lower values = more deterministic, higher values = more creative
# For reasoning tasks, 0.7 is usually a good balance
LLM_TEMPERATURE=0.7

# LLM Request Timeout (seconds)
# Mathematical reasoning models need longer timeouts due to complex reasoning
# Default timeouts: 60s (standard models), 180s (math models), 90s (large models)
# Set higher for slow models or complex reasoning tasks
LLM_TIMEOUT=300

# LiteLLM Server Configuration
# Base URL for your LiteLLM Docker container
# Default assumes local Docker setup on port 4000
LLM_BASE_URL=http://localhost:4000

# API Key for LLM Provider
# For local LiteLLM proxy, use the master key configured in litellm_config.yaml
# For actual providers, use your real API key
LLM_API_KEY=sk-1234

# LLM Provider API Keys
# Required for the configured models in litellm_config.yaml
# Uncomment and set the appropriate API key for your chosen provider

# OpenRouter API Key (for openrouter/ models - RECOMMENDED for token confidence)
# Get your API key from: https://openrouter.ai/keys
# OpenRouter provides access to many models including GPT-4o with logprobs support
# Required for: openrouter/gpt-4o-mini, openrouter/gpt-4o
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# OpenAI API Key (for direct gpt-4o, gpt-4o-mini, gpt-3.5-turbo)
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (for claude-3-5-sonnet - does NOT support logprobs)  
# Get your API key from: https://console.anthropic.com/
# Note: Claude models don't support logprobs, use for traditional consensus only
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google/Gemini API Key (for gemini-pro, gemini-1.5-pro, etc.)
# Get your API key from: https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=your-google-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here

# Ollama Configuration (for codegeex4, gemma2-2b, gemma-2b, gemma, mistral-7b, phi4, qwen2-math-7b, deepseek-math-7b)
# Ollama models don't require API keys - they run on your own infrastructure
# The remote Ollama endpoint is pre-configured in litellm_config.yaml at http://100.93.83.103:11434
# Available models: codegeex4, gemma2-2b, gemma-2b, gemma, mistral-7b, phi4, qwen2-math-7b, deepseek-math-7b
# Mathematical reasoning models: qwen2-math-7b (official), deepseek-math-7b (community)
# Example usage: LLM_MODEL=qwen2-math-7b

# Additional LLM Parameters (optional)
# Uncomment and modify as needed for your use case

# Maximum tokens to generate
# LLM_MAX_TOKENS=1000

# Top-p sampling parameter (0.0 - 1.0)
# LLM_TOP_P=1.0

# Frequency penalty (-2.0 - 2.0)
# LLM_FREQUENCY_PENALTY=0.0

# Presence penalty (-2.0 - 2.0)
# LLM_PRESENCE_PENALTY=0.0

# Self-Consistency Agent Configuration
# Number of responses to generate for consensus
SC_TARGET_RESPONSES=5

# Default prompt template for Chain-of-Thought reasoning
SC_PROMPT_TEMPLATE="Think step by step and provide your reasoning before giving your final answer. End your response with 'The answer is [your answer]'."

# Enhanced Self-Consistency Agent Configuration (Token Confidence Features)
# These settings apply to the enhanced agent with structured logprobs integration

# Models that support token confidence features (structured outputs + logprobs):
# ✅ openrouter/gpt-4o-mini    - Best performance/cost ratio (RECOMMENDED)
# ✅ openrouter/gpt-4o         - Higher quality, more expensive
# ✅ gpt-4o-mini              - Direct OpenAI (requires OPENAI_API_KEY)
# ✅ gpt-4o                   - Direct OpenAI (requires OPENAI_API_KEY)
# ❌ claude-3-haiku           - No logprobs support (traditional consensus only)
# ❌ claude-3-5-sonnet        - No logprobs support (traditional consensus only)

# To use token confidence features:
# 1. Set LLM_MODEL to a supported model (see above)
# 2. Set the appropriate API key (OPENROUTER_API_KEY or OPENAI_API_KEY)  
# 3. Restart LiteLLM: make litellm-stop && make litellm-start
# 4. Run: python examples/enhanced_self_consistency_demo.py

# Development and Testing Configuration
# Set to true to enable debug logging
DEBUG=false

# Test environment overrides
# These are used by the test suite
TEST_LLM_MODEL=mock-model
TEST_LLM_BASE_URL=http://localhost:4000
TEST_LLM_API_KEY=sk-test

# Docker Configuration (for development)
# Override default Docker settings if needed
DOCKER_IMAGE=ghcr.io/berriai/litellm:main-latest
CONTAINER_NAME=litellm-server
HOST_PORT=4000
LITELLM_PORT=4000