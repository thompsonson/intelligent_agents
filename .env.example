# LiteLLM Configuration for Self-Consistency Agent
# Copy this file to .env and configure your settings

# LLM Model Configuration
# The model identifier to use with your LLM provider
# Examples: gpt-4, claude-3-sonnet, llama-2-70b-chat
LLM_MODEL=gpt-4o

# LLM Temperature (0.0 - 2.0)
# Lower values = more deterministic, higher values = more creative
# For reasoning tasks, 0.7 is usually a good balance
LLM_TEMPERATURE=0.7

# LiteLLM Server Configuration
# Base URL for your LiteLLM Docker container
# Default assumes local Docker setup on port 4000
LLM_BASE_URL=http://localhost:4000

# API Key for LLM Provider
# For local LiteLLM proxy, you may need to set this to a dummy value
# For actual providers, use your real API key
LLM_API_KEY=sk-dummy

# Additional LLM Parameters (optional)
# Uncomment and modify as needed for your use case

# Maximum tokens to generate
# LLM_MAX_TOKENS=1000

# Top-p sampling parameter (0.0 - 1.0)
# LLM_TOP_P=1.0

# Frequency penalty (-2.0 - 2.0)
# LLM_FREQUENCY_PENALTY=0.0

# Presence penalty (-2.0 - 2.0)
# LLM_PRESENCE_PENALTY=0.0

# Self-Consistency Agent Configuration
# Number of responses to generate for consensus
SC_TARGET_RESPONSES=5

# Default prompt template for Chain-of-Thought reasoning
SC_PROMPT_TEMPLATE="Think step by step and provide your reasoning before giving your final answer. End your response with 'The answer is [your answer]'."

# Development and Testing Configuration
# Set to true to enable debug logging
DEBUG=false

# Test environment overrides
# These are used by the test suite
TEST_LLM_MODEL=mock-model
TEST_LLM_BASE_URL=http://localhost:4000
TEST_LLM_API_KEY=sk-test

# Docker Configuration (for development)
# Override default Docker settings if needed
DOCKER_IMAGE=ghcr.io/berriai/litellm:main-latest
CONTAINER_NAME=litellm-server
HOST_PORT=4000
LITELLM_PORT=4000